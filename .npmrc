@sabeesoft:registry=https://registry.npmjs.org/
# No _authToken here on purpose: pnpm does not expand environment variables
# in the project .npmrc, so a line like ${NPM_TOKEN} would silently be sent
# as no credentials at all. CI writes the token to the user-level config
# (`pnpm config set`), and locally `pnpm login` does the same.
engine-strict=true
