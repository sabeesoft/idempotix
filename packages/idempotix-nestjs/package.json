{
  "name": "@sabeesoft/idempotix-nestjs",
  "version": "0.1.0",
  "description": "NestJS module, decorator, and interceptor for idempotent HTTP endpoints.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sabeesoft/idempotix/tree/main/packages/idempotix-nestjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabeesoft/idempotix.git",
    "directory": "packages/idempotix-nestjs"
  },
  "bugs": {
    "url": "https://github.com/sabeesoft/idempotix/issues"
  },
  "author": "sabeesoft",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sabeesoft/idempotix-core": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@types/supertest": "^7.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2"
  }
}
