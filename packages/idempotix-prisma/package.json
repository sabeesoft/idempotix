{
  "name": "@sabeesoft/idempotix-prisma",
  "version": "0.0.0",
  "description": "Prisma store adapter and query/transaction instrumentation for idempotix.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "pretest": "prisma generate",
    "test": "vitest run",
    "clean": "rimraf dist src/generated"
  },
  "dependencies": {
    "@sabeesoft/idempotix-core": "workspace:*",
    "@sabeesoft/idempotix-pg": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@nestjs-cls/transactional": "^3.3.0",
    "@nestjs-cls/transactional-adapter-prisma": "^1.4.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sabeesoft/idempotix-nestjs": "workspace:*",
    "@sabeesoft/idempotix-testing": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "nestjs-cls": "^6.3.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
