{
  "name": "@sabeesoft/idempotix-pg",
  "version": "0.1.0",
  "description": "Shared PostgreSQL support for idempotix adapters: the idempotency SQL, row mapping and pg pool instrumentation.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/sabeesoft/idempotix/tree/main/packages/idempotix-pg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabeesoft/idempotix.git",
    "directory": "packages/idempotix-pg"
  },
  "bugs": {
    "url": "https://github.com/sabeesoft/idempotix/issues"
  },
  "author": "sabeesoft",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@sabeesoft/idempotix-core": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "pg": "^8.16.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}
